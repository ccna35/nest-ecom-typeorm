{
  "openapi": "3.0.0",
  "info": {
    "title": "Seller Applications API",
    "description": "API endpoints for customer-to-seller application workflow",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Seller Applications",
      "description": "Endpoints for managing seller applications"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "CreateSellerApplicationDto": {
        "type": "object",
        "required": ["storeName", "storeDescription"],
        "properties": {
          "storeName": {
            "type": "string",
            "maxLength": 255,
            "example": "Tech Haven Store"
          },
          "storeDescription": {
            "type": "string",
            "minLength": 50,
            "maxLength": 2000,
            "example": "Tech Haven is your one-stop shop for all the latest gadgets, electronics, and tech accessories. We pride ourselves on offering competitive prices and excellent customer service."
          }
        }
      },
      "RejectApplicationDto": {
        "type": "object",
        "required": ["rejectionReason"],
        "properties": {
          "rejectionReason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "example": "The store description does not provide enough information about your business model and target market."
          }
        }
      },
      "SellerApplication": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "987e6543-e89b-12d3-a456-426614174000"
          },
          "storeName": {
            "type": "string",
            "example": "Tech Haven Store"
          },
          "storeDescription": {
            "type": "string",
            "example": "Tech Haven is your one-stop shop for all the latest gadgets..."
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected"],
            "example": "pending"
          },
          "rejectionReason": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "reviewedById": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "example": null
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-02-17T10:30:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-02-17T10:30:00.000Z"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": ["admin", "customer", "seller"]
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/seller-applications": {
      "post": {
        "tags": ["Seller Applications"],
        "summary": "Submit seller application (Customer only)",
        "description": "Allows a customer to submit an application to become a seller",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSellerApplicationDto"
              },
              "examples": {
                "valid": {
                  "summary": "Valid application",
                  "value": {
                    "storeName": "Tech Haven Store",
                    "storeDescription": "Tech Haven is your one-stop shop for all the latest gadgets, electronics, and tech accessories. We pride ourselves on offering competitive prices and excellent customer service to tech enthusiasts worldwide."
                  }
                },
                "invalid-short-description": {
                  "summary": "Invalid - description too short",
                  "value": {
                    "storeName": "Tech Store",
                    "storeDescription": "Short description"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerApplication"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation failed or user is not a customer",
            "content": {
              "application/json": {
                "examples": {
                  "not-customer": {
                    "value": {
                      "statusCode": 400,
                      "message": "Only customers can apply to become sellers"
                    }
                  },
                  "already-applied": {
                    "value": {
                      "statusCode": 400,
                      "message": "You have already submitted an application"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Not logged in"
          }
        }
      },
      "get": {
        "tags": ["Seller Applications"],
        "summary": "List all applications (Admin only)",
        "description": "Get all seller applications with optional status filter",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["pending", "approved", "rejected"]
            },
            "description": "Filter applications by status"
          }
        ],
        "responses": {
          "200": {
            "description": "List of applications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SellerApplication"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Not an admin"
          }
        }
      }
    },
    "/seller-applications/me": {
      "get": {
        "tags": ["Seller Applications"],
        "summary": "Get own application (Customer/Seller)",
        "description": "Retrieve the current user's seller application",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "User's application",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SellerApplication"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/seller-applications/{id}": {
      "get": {
        "tags": ["Seller Applications"],
        "summary": "Get application by ID (Admin only)",
        "description": "Retrieve a specific seller application",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Application details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerApplication"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Not an admin"
          },
          "404": {
            "description": "Application not found"
          }
        }
      }
    },
    "/seller-applications/{id}/approve": {
      "post": {
        "tags": ["Seller Applications"],
        "summary": "Approve application (Admin only)",
        "description": "Approve a pending seller application, update user role to SELLER, and create seller profile",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Application approved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerApplication"
                },
                "example": {
                  "id": "123e4567-e89b-12d3-a456-426614174000",
                  "userId": "987e6543-e89b-12d3-a456-426614174000",
                  "storeName": "Tech Haven Store",
                  "storeDescription": "Tech Haven is your one-stop shop...",
                  "status": "approved",
                  "rejectionReason": null,
                  "reviewedById": "admin-uuid",
                  "reviewedAt": "2026-02-17T11:00:00.000Z",
                  "createdAt": "2026-02-17T10:30:00.000Z",
                  "updatedAt": "2026-02-17T11:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Application is not pending",
            "content": {
              "application/json": {
                "example": {
                  "statusCode": 400,
                  "message": "Only pending applications can be approved"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Not an admin"
          },
          "404": {
            "description": "Application not found"
          }
        }
      }
    },
    "/seller-applications/{id}/reject": {
      "post": {
        "tags": ["Seller Applications"],
        "summary": "Reject application (Admin only)",
        "description": "Reject a pending seller application with a reason",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectApplicationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application rejected successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerApplication"
                },
                "example": {
                  "id": "123e4567-e89b-12d3-a456-426614174000",
                  "userId": "987e6543-e89b-12d3-a456-426614174000",
                  "storeName": "Tech Haven Store",
                  "storeDescription": "Tech Haven is your one-stop shop...",
                  "status": "rejected",
                  "rejectionReason": "The store description does not provide enough information",
                  "reviewedById": "admin-uuid",
                  "reviewedAt": "2026-02-17T11:00:00.000Z",
                  "createdAt": "2026-02-17T10:30:00.000Z",
                  "updatedAt": "2026-02-17T11:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Application is not pending",
            "content": {
              "application/json": {
                "example": {
                  "statusCode": 400,
                  "message": "Only pending applications can be rejected"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Not an admin"
          },
          "404": {
            "description": "Application not found"
          }
        }
      }
    }
  }
}
